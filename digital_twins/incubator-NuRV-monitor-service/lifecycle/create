#!/bin/bash

set -e # Exit on command failure

apt_updated=false

check_binary() {
    if dpkg -s "$1" &> /dev/null; then
        echo "$1 is installed."
    else
        echo "$1 is not installed. Installing."
        if [ "$apt_updated" = false ]; then
            sudo apt-get update
            apt_updated=true
        fi
        sudo apt-get install -y "${2:-$1}" # Install argument 2 if provided, otherwise 1
    fi
}

echo "Checking dependencies"

# Install stuff
check_binary "python3"
check_binary "python3-venv"
check_binary "python3-dev"
check_binary "build-essential"
check_binary "pkg-config"
check_binary "bzip2"
# omniORB libraries, IDL compiler and naming service (omniNames)
check_binary "libomniorb4-dev"
check_binary "omniidl"
check_binary "omniorb-idl"
check_binary "omniorb-nameserver"

# Base relative paths off lifecycle dir
cd "$(dirname "${BASH_SOURCE[0]}")"

# create .orbitrc file with correct contents
echo -e "ORBIIOPUSock=1\\nORBIIOPIPv4=1\\nORBIIOPIPv6=0" > $HOME/.orbitrc

: ${NURV_PATH:=../../../common/services/NuRV}
echo "Using NURV_PATH: ${NURV_PATH}"
sudo apt-get install -y "$(realpath "$NURV_PATH")"/orbit2/*.deb
# download NuRV tool if necessary
if ! test -f "${NURV_PATH}/NuRV_orbit"; then
    curl -o ../../../common/services/NuRV.tar.bz2 "https://es-static.fbk.eu/tools/nurv/releases/NuRV-2.0.0-linuxx64.tar.bz2"
    tar xjf ../../../common/services/NuRV.tar.bz2 -C ../../../common/services/
    rm ../../../common/services/NuRV.tar.bz2
    mv ../../../common/services/NuRV-2.0.0-linuxx64/* $NURV_PATH
    rmdir ../../../common/services/NuRV-2.0.0-linuxx64
fi

: ${INCUBATOR_PATH:=../../../common/digital_twins/incubator} # Set variable if not manually exported
echo "Using INCUBATOR_PATH: ${INCUBATOR_PATH}"

python3 -m venv .venv
source .venv/bin/activate
pip install --upgrade pip
pip install -r "${INCUBATOR_PATH}/requirements.txt" -r ../requirements.txt

# omniORBpy has no wheels for the Python version of Ubuntu 24.04.
# Build it against the omniORB libraries installed above.
if ! python -c "import omniORB" &> /dev/null; then
    OMNIORB_VERSION=$(dpkg-query -W -f='${Version}' libomniorb4-dev | cut -d+ -f1)
    VENV_PATH=$(realpath .venv)
    BUILD_PATH=$(mktemp -d)
    curl -fsSL -o "${BUILD_PATH}/omniORBpy.tar.bz2" \
        "https://downloads.sourceforge.net/project/omniorb/omniORBpy/omniORBpy-${OMNIORB_VERSION}/omniORBpy-${OMNIORB_VERSION}.tar.bz2"
    tar xjf "${BUILD_PATH}/omniORBpy.tar.bz2" -C "${BUILD_PATH}"
    mkdir "${BUILD_PATH}/build"
    (
        cd "${BUILD_PATH}/build"
        "../omniORBpy-${OMNIORB_VERSION}/configure" --prefix="${VENV_PATH}" \
            --with-omniorb=/usr PYTHON="${VENV_PATH}/bin/python"
        make
        make install
    )
    rm -rf "${BUILD_PATH}"
fi
