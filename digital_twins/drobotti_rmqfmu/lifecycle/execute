#!/bin/bash
# Base relative paths off the digital twin directory
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit
: "${EXAMPLES_PATH:=$(realpath ../..)}" # Set variable if not manually exported
: "${MAESTRO:=${EXAMPLES_PATH}/common/tools}"
: "${FSP:=${EXAMPLES_PATH}/models}"
DATA="${EXAMPLES_PATH}/data/$(basename "$PWD")"

echo "Configuring extension"
printf "\t Maestro path: %s\n" "$MAESTRO"
printf "\t FMU search path: %s\n" "$FSP"

echo "Generating Mabl specification"

java -jar "$MAESTRO/maestro-4.1.0-jar-with-dependencies.jar" import sg1 ./coe.json ./multimodel.json -fsp "$FSP" -output ./generate/

echo "Run publisher script in other terminal"

python3 "$DATA/rmq-publisher.py" 2>&1 | tee ./publisher-out.txt &

python3 "$DATA/consume.py" 2>&1 | tee ./consume.txt &

echo "Simulating specifications"

java -jar "$MAESTRO/maestro-4.1.0-jar-with-dependencies.jar" interpret ./generate/spec.mabl -output ./target 2>&1 | tee ./out.txt
