#!/bin/bash

# exit if a command fails
set -e

# Base relative paths off the digital twin directory
cd "$(dirname "${BASH_SOURCE[0]}")/.."

printf "Install apt dependencies \n"

sudo apt-get update
sudo apt-get install -y ca-certificates curl gnupg build-essential default-jre-headless cargo jq tmux python3-venv

printf "Install OpenModelica \n"

if dpkg -s omc &> /dev/null; then
  echo "OpenModelica is already installed"
else
  curl -fsSL --retry 5 --retry-all-errors https://build.openmodelica.org/apt/openmodelica.asc \
    | sudo gpg --dearmor --yes -o /usr/share/keyrings/openmodelica-keyring.gpg
  # shellcheck disable=SC1091
  . /etc/os-release
  echo "deb [arch=amd64 signed-by=/usr/share/keyrings/openmodelica-keyring.gpg] \
    https://build.openmodelica.org/apt \
    ${VERSION_CODENAME} \
    stable" | sudo tee /etc/apt/sources.list.d/openmodelica.list
  # The OpenModelica server can be slow; retry until its package index is available
  for attempt in 1 2 3 4 5; do
    sudo apt-get update || true
    apt-cache policy omc | grep -q "build.openmodelica.org" && break
    printf "Attempt %s to download the OpenModelica package index failed\n" "$attempt"
    sleep 30
  done
  # the OpenModelica server can be slow; retry the downloads
  for attempt in 1 2 3 4 5; do
    sudo apt-get install -y -o Acquire::Retries=5 --no-install-recommends omc && break
    printf "Attempt %s to download OpenModelica failed\n" "$attempt"
    sleep 30
  done
  command -v omc > /dev/null
fi

printf "Install telegraf \n"

if dpkg -s telegraf &> /dev/null; then
  echo "Telegraf is already installed"
else
  # influxdata-archive.key GPG Fingerprint: 24C975CBA61A024EE1B631787C3D57159FC2F927
  curl -fsSL -o influxdata-archive.key https://repos.influxdata.com/influxdata-archive.key
  gpg --show-keys --with-fingerprint --with-colons ./influxdata-archive.key 2>&1 \
    | grep -q '^fpr:\+24C975CBA61A024EE1B631787C3D57159FC2F927:$'
  gpg --dearmor < influxdata-archive.key \
    | sudo tee /etc/apt/keyrings/influxdata-archive.gpg > /dev/null
  echo 'deb [signed-by=/etc/apt/keyrings/influxdata-archive.gpg] https://repos.influxdata.com/debian stable main' \
    | sudo tee /etc/apt/sources.list.d/influxdata.list
  sudo apt-get update && sudo apt-get install -y telegraf
  rm influxdata-archive.key
fi

printf "Install required pip packages \n"

python3 -m venv o5g-venv
source o5g-venv/bin/activate
pip install --upgrade pip
pip install numpy scipy networkx matplotlib fmpy pytest "paho-mqtt<2.0.0"
