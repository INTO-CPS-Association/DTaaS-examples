#!/bin/bash
# Base relative paths off the digital twin directory
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit
: "${EXAMPLES_PATH:=$(realpath ../..)}" # Set variable if not manually exported
OUTPUT_PATH="${EXAMPLES_PATH}/data/$(basename "$PWD")/output"
PYTHON=".venv/bin/python"

"$PYTHON" "${EXAMPLES_PATH}/data/opc-ua-waterplant/opcua-mock-server.py" "$PWD/config.json" &
SERVER_PID=$!

printf "waiting 30 seconds for OPC UA server to start...\n"
sleep 30

"$PYTHON" "${EXAMPLES_PATH}/tools/opc-ua-waterplant/client-opcua.py" "$PWD/config.json" 2>&1 | \
  tee "${OUTPUT_PATH}/execute.log"
kill -SIGKILL "$SERVER_PID"
