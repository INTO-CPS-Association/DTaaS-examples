#!/bin/bash

PYTHON=".venv/bin/python"

"$PYTHON" "/workspace/data/opc-ua-waterplant/opcua-mock-server.py" &
SERVER_PID=$!

printf "waiting 30 seconds for OPC UA server to start...\n"
sleep 30

"$PYTHON" /workspace/tools/opc-ua-waterplant/client-opcua.py 2>&1 | \
  tee "/workspace/data/opc-ua-waterplant/output/execute.log"
kill -SIGKILL "$SERVER_PID"
