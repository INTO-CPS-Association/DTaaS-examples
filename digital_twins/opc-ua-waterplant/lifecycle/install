#!/bin/bash

set -e # Exit on command failure

# install openmodelica
sudo apt-get update
sudo apt-get install -y ca-certificates curl gnupg
curl -fsSL --retry 5 --retry-all-errors https://build.openmodelica.org/apt/openmodelica.asc | \
  sudo gpg --dearmor --yes -o /usr/share/keyrings/openmodelica-keyring.gpg
# shellcheck disable=SC1091
. /etc/os-release
echo "deb [arch=amd64 signed-by=/usr/share/keyrings/openmodelica-keyring.gpg] \
  https://build.openmodelica.org/apt \
  ${VERSION_CODENAME} \
  stable" | sudo tee /etc/apt/sources.list.d/openmodelica.list
sudo apt-get update
# the OpenModelica server can be slow; retry the downloads
sudo apt-get install -y -o Acquire::Retries=5 --no-install-recommends omc

# install python virtual environment with the project requirements
sudo apt-get install -y build-essential python3-venv python3-dev
python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r lifecycle/requirements_linux.txt
