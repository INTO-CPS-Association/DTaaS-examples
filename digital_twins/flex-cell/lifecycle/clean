#!/bin/bash
# Base relative paths off the digital twin directory
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit
: "${EXAMPLES_PATH:=$(realpath ../..)}" # Set variable if not manually exported
OUTPUT_PATH="${EXAMPLES_PATH}/data/$(basename "$PWD")/output"

printf "Cleaning %s, but keeping the saved_experiments folder \n\n" "$OUTPUT_PATH"
find "$OUTPUT_PATH" -mindepth 1 -maxdepth 1 ! -name saved_experiments -exec rm -rf {} +
