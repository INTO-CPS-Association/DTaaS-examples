#!/bin/bash
# Base relative paths off the digital twin directory
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit
: "${EXAMPLES_PATH:=$(realpath ../..)}" # Set variable if not manually exported
MODELS_PATH="${EXAMPLES_PATH}/models"

printf "Preparing file with credentials...\n\n"
## From the DTaaS-examples
source "${EXAMPLES_PATH}/tools/flex-cell/requirements/venv/bin/activate"
BUILD_PATH=$(mktemp -d)
unzip "${MODELS_PATH}/rmqfmu-vhost.fmu" -d "$BUILD_PATH"
python "${EXAMPLES_PATH}/functions/flex-cell/prepare.py"
cp "${MODELS_PATH}/flex-cell/modelDescription.xml" "$BUILD_PATH/"
cp "${MODELS_PATH}/flex-cell/modelDescription.xml" "$BUILD_PATH/resources/"
rm -f "${MODELS_PATH}/flex-cell/rmqfmu_flexcell.fmu"
(cd "$BUILD_PATH" && zip -r rmqfmu_flexcell.fmu .)
cp "$BUILD_PATH/rmqfmu_flexcell.fmu" "${MODELS_PATH}/flex-cell/"
rm -r "$BUILD_PATH"
