    ]
  },
  "parameters": {
    "{x1}.controller.maxlevel": 2,
    "{x1}.controller.minlevel": 1
  },
  "algorithm": {
    "type": "fixed-step",
    "size": 0.1
  },

  "faultInjectConfigurationPath": "wt_fault.xml",
  "faultInjectInstances": {
    "tank": "id-A"
  }
}
