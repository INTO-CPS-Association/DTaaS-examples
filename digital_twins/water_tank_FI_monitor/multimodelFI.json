{
  "fmus": {
    "{x1}": "../../models/watertankcontroller-c.fmu",
    "{x2}": "../../models/singlewatertank-20sim.fmu",
    "{x3}": "../../models/RtI.fmu",
    "{x4}": "../../models/m1.fmu"
  },
  "connections": {
    "{x1}.controller.valve": [
      "{x2}.tank.valvecontrol"
    ],
    "{x2}.tank.level": [
      "{x1}.controller.level",
      "{x3}.RtIInstance.u"
    ],
