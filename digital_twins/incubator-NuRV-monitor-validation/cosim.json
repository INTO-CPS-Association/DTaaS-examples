{
	"fmus": {
		"{ad}": "../../models/anomaly_detection.fmu",
		"{es}": "../../models/energy_saver.fmu",
		"{src}": "../../models/Source.fmu",
		"{wtc}": "../../models/Watcher.fmu",
		"{mon}": "../../models/safe-operation.fmu"
	},
	"connections": {
		"{src}.src.sensor_data": [
			"{ad}.ad.sensor_data"
		],
		"{src}.src.error_threshold": [
			"{ad}.ad.error_threshold"
		],
		"{src}.src.kalman_input": [
			"{ad}.ad.kalman_input"
		],
		"{ad}.ad.verdict": [
			"{es}.es.lid_open",
			"{mon}.mon.anomaly"
		],
		"{es}.es.ctrl_desired_temperature": [
			"{wtc}.dtc.desired_temperature"
		],
		"{wtc}.dtc.energy_saving": [
			"{mon}.mon.energy_saving"
		]
	},
	"logVariables": {
		"{src}.src": [
			"sensor_data",
			"kalman_input"
		],
		"{es}.es": [
			"ctrl_desired_temperature"
		],
		"{mon}.mon": [
			"_output"
		]
	},
	"parameters": {},
	"algorithm": {
		"type": "fixed-step",
		"size": 1.0
	},
	"loggingOn": false,
	"overrideLogLevel": "INFO"
}