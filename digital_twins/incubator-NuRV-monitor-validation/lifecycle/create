#!/bin/bash

set -e # Exit on command failure

# Base relative paths off the digital twin directory
cd "$(dirname "${BASH_SOURCE[0]}")/.."
: "${EXAMPLES_PATH:=$(realpath ../..)}" # Set variable if not manually exported
: "${NURV:=${EXAMPLES_PATH}/common/tools/NuRV/NuRV}"
: "${FMI2_HEADERS:=${EXAMPLES_PATH}/common/fmi2_headers}"
MODELS_PATH="${EXAMPLES_PATH}/models"

echo "Installing dependencies and create configuration"

sudo apt-get update
sudo apt-get install -y openjdk-21-jre
sudo apt-get install -y python3-pandas python3-matplotlib \
  python3-protobuf python3-zmq
sudo apt-get install -y zip make gcc

"$NURV" -quiet -source lifecycle/synthesis_incubator_monitor_fmu.cmd
sed -i 's\Enumeration declaredType="eu.fbk.nurv.RV_value"\Integer\g' \
    safe-operation/modelDescription.xml

FMI2_HOME=$FMI2_HEADERS make -C safe-operation linux64
mv safe-operation.fmu "${MODELS_PATH}/safe-operation.fmu"
